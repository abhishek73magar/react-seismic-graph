{
  "name": "react-seismic-graph",
  "version": "0.3.0",
  "description": "Seismic waveform + spectrogram and helicorder for React and plain HTML",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abhishek73magar/react-seismic-graph.git"
  },
  "homepage": "https://abhishek73magar.github.io/react-seismic-graph/",
  "bugs": {
    "url": "https://github.com/abhishek73magar/react-seismic-graph/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/types/react/index.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./mseed": {
      "types": "./dist/types/mseed/index.d.ts",
      "import": "./dist/mseed.js",
      "require": "./dist/mseed.cjs"
    }
  },
  "unpkg": "./dist/seismic-graph.iife.js",
  "jsdelivr": "./dist/seismic-graph.iife.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --mode iife && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./test/register.mjs test/core.test.ts && node --import ./test/register.mjs test/mseed.test.ts && node --import ./test/register.mjs test/decode.test.ts",
    "prepublishOnly": "pnpm test && pnpm typecheck && pnpm build",
    "release": "npm publish --access public",
    "release:dry": "npm publish --dry-run",
    "build:examples": "vite build --mode examples",
    "push:patch": "npm version patch && git push --follow-tags",
    "push:minor": "npm version minor && git push --follow-tags",
    "push:major": "npm version major && git push --follow-tags"
  },
  "keywords": [
    "seismology",
    "seismogram",
    "spectrogram",
    "helicorder",
    "waveform",
    "react",
    "canvas"
  ],
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "seisplotjs": "3.2.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
