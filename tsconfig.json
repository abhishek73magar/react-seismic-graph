{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "types": [],
    "paths": {
      "react-seismic-graph": ["./src/index.ts"],
      "react-seismic-graph/react": ["./src/react/index.ts"],
      "react-seismic-graph/seisplotjs": ["./src/seisplotjs/index.ts"]
    }
  },
  "include": ["src", "examples"]
}
